.assistant-page {
  padding: 1.5rem;
  min-height: 100vh;
  background: linear-gradient(135deg, #f8fbff 0%, #eef4ff 100%);
}

.assistant-panel {
  max-width: 1200px;
  margin: 0 auto;
  background: #ffffff;
  border-radius: 24px;
  box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
  overflow: hidden;
}

.assistant-header {
  background: linear-gradient(90deg, #2563eb 0%, #4f46e5 100%);
  color: white;
  padding: 1.4rem 1.6rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.assistant-header h1 {
  margin: 0;
  font-size: 1.65rem;
}

.assistant-header p {
  margin: 0.3rem 0 0;
  opacity: 0.95;
}

.assistant-badge {
  background: rgba(255,255,255,0.18);
  padding: 0.5rem 0.85rem;
  border-radius: 999px;
  font-size: 0.85rem;
  white-space: nowrap;
}

.assistant-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem;
  padding: 1rem 1.6rem 0;
}

.assistant-chip {
  border: 1px solid #dbeafe;
  background: #eff6ff;
  color: #1d4ed8;
  padding: 0.6rem 0.9rem;
  border-radius: 999px;
  font-size: 0.92rem;
  cursor: pointer;
}

.assistant-chat-window {
  min-height: 380px;
  max-height: 520px;
  overflow-y: auto;
  padding: 1rem 1.6rem;
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  background: #f8fafc;
}

.assistant-empty-state {
  text-align: center;
  padding: 3rem 1rem;
  color: #475569;
}

.assistant-message-row {
  display: flex;
}

.assistant-bubble {
  max-width: 85%;
  padding: 0.9rem 1rem;
  border-radius: 16px;
  line-height: 1.6;
  white-space: pre-line;
}

.assistant-bubble.user {
  margin-left: auto;
  background: #2563eb;
  color: white;
}

.assistant-bubble.assistant {
  background: white;
  border: 1px solid #e2e8f0;
  color: #0f172a;
}

.assistant-message-text {
  margin-bottom: 0.65rem;
}

.assistant-card-list {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.assistant-card-item {
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 0.75rem;
  background: #f8fafc;
}

.assistant-card-title {
  font-weight: 700;
  color: #111827;
}

.assistant-card-subtitle {
  font-size: 0.9rem;
  color: #64748b;
  margin-top: 0.2rem;
}

.assistant-card-summary {
  margin-top: 0.45rem;
  color: #334155;
}

.assistant-card-location,
.assistant-link {
  margin-top: 0.4rem;
  display: inline-block;
  font-size: 0.9rem;
  color: #2563eb;
  text-decoration: none;
  font-weight: 600;
}

.assistant-input-card {
  padding: 1rem 1.6rem 1.4rem;
  border-top: 1px solid #e2e8f0;
}

.assistant-input-card textarea {
  width: 100%;
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  padding: 0.9rem 1rem;
  resize: vertical;
  min-height: 110px;
  font-size: 0.95rem;
  outline: none;
}

.assistant-input-card textarea:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

.assistant-submit {
  margin-top: 0.9rem;
  border: none;
  background: linear-gradient(90deg, #2563eb 0%, #4f46e5 100%);
  color: white;
  border-radius: 999px;
  padding: 0.75rem 1rem;
  cursor: pointer;
  font-weight: 600;
}

.assistant-submit:hover {
  transform: translateY(-2px);
}

.assistant-error {
  display: block;
  color: #dc2626;
  font-size: 0.9rem;
  margin-top: 0.6rem;
}

.assistant-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #64748b;
  margin: 0 2px;
  animation: pulse 1.2s infinite ease-in-out;
}

.assistant-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.assistant-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes pulse {
  0%, 80%, 100% { transform: scale(0.8); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

@media (max-width: 900px) {
  .assistant-bubble {
    max-width: 95%;
  }
}

@media (max-width: 640px) {
  .assistant-page {
    padding: 1rem;
  }

  .assistant-header {
    padding: 1.2rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .assistant-chat-window,
  .assistant-input-card,
  .assistant-suggestions {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}